# ============================================================================
# KEY INSTITUTE · CONFIGURACIÓN GOOGLE / MICROSOFT ENTRA ID (AZURE AD) Y SEGURIDAD
# ============================================================================

# 1. Credenciales de Proveedores OAuth (Google Identity Services y Microsoft Entra ID)
# Coloca tu Client ID de Google Cloud Console:
VITE_GOOGLE_CLIENT_ID=992221704874-eg8ah1q0j8s1a9r1k5sl91o51uhr55ma.apps.googleusercontent.com

# Deja VITE_MSAL_CLIENT_ID vacío durante el desarrollo local para activar
# automáticamente el Simulador Interactivo de Microsoft SSO.
# Al colocar tu Client ID real de Azure, se activará el popup oficial de Microsoft.
VITE_MSAL_CLIENT_ID=a80687e4-353c-4654-a13e-8f3c21438110
VITE_MSAL_TENANT_ID=common
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# 2. Control de Cuentas Demo Rápidas en Pantalla de Login
# En desarrollo ('true') muestra el panel inferior colapsable de cuentas demo.
# En producción cámbialo a 'false' para que desaparezca por completo.
VITE_ENABLE_DEMO_ACCOUNTS=true

# 3. Seguridad Backend: Dominios permitidos y PIN de Cátedra Docente
# Para estudiantes: '*' permite cualquier correo personal (@gmail.com, @outlook.com) o institucional
ALLOWED_EMAIL_DOMAINS=*

# Dominios institucionales exclusivos obligatorios para el acceso de Docentes:
TEACHER_EMAIL_DOMAINS=keyinstitute.com,keyinstitute.edu.sv
VITE_TEACHER_EMAIL_DOMAINS=keyinstitute.com,keyinstitute.edu.sv

# Código/PIN institucional requerido para registrar o elevar una cuenta a Docente
TEACHER_ACCESS_PIN=CAMBIAR_PIN_AQUI

# Si es 'true', pedirá el PIN Docente en cada inicio de sesión aunque ya esté en SQLite
ALWAYS_REQUIRE_TEACHER_PIN=false
