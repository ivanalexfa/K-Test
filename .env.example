# ============================================================================
# KEY INSTITUTE · CONFIGURACIÓN MICROSOFT ENTRA ID (AZURE AD) Y SEGURIDAD
# ============================================================================

# 1. Credenciales de Microsoft Entra ID (Portal de Azure -> App Registrations)
# Deja VITE_MSAL_CLIENT_ID vacío durante el desarrollo local para activar
# automáticamente el Simulador Interactivo de Microsoft SSO.
# Al colocar tu Client ID real de Azure, se activará el popup oficial de Microsoft.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=common
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# 2. Control de Cuentas Demo Rápidas en Pantalla de Login
# En desarrollo ('true') muestra el panel inferior colapsable de cuentas demo.
# En producción cámbialo a 'false' para que desaparezca por completo.
VITE_ENABLE_DEMO_ACCOUNTS=true

# 3. Seguridad Backend: Dominios permitidos y PIN de Cátedra Docente (Opción 1)
# Usa '*' en desarrollo para aceptar cualquier correo Microsoft, o separa por comas
# en producción (ej. keyinstitute.edu.sv,keyinstitute.com)
ALLOWED_EMAIL_DOMAINS=*

# Código/PIN institucional requerido para registrar o elevar una cuenta Microsoft a Docente
TEACHER_ACCESS_PIN=CAMBIAR_PIN_AQUI

# Si es 'true', pedirá el PIN Docente en cada inicio de sesión aunque ya esté en SQLite
ALWAYS_REQUIRE_TEACHER_PIN=false
