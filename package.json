{
  "name": "paa-simulator-key-institute",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-api.mjs",
    "preview": "vite preview",
    "test": "node scripts/test-api.mjs",
    "test:api": "node scripts/test-api.mjs",
    "fotos": "node scripts/optimizar-fotos.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verificar": "npm run lint && npm run typecheck && npm run test:web && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.27.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  }
}
